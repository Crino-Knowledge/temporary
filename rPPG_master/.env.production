# rPPG生产环境配置文件
# 请根据实际服务器环境修改相应配置

# ===========================================
# 基础配置
# ===========================================
FLASK_ENV=production
FLASK_DEBUG=false
NODE_ENV=production

# ===========================================
# 安全配置 - 生产环境必须修改
# ===========================================
# 请使用以下命令生成随机密钥：
# openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
PORT=5000

# ===========================================
# GPU配置
# ===========================================
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
USE_GPU=true
GPU_DEVICE_ID=0

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/rppg-backend.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ===========================================
# 性能配置
# ===========================================
MAX_ACTIVE_SESSIONS=10
SESSION_TIMEOUT=300
FRAME_BUFFER_SIZE=30
MAX_WORKERS=4
THREAD_POOL_SIZE=8
PROCESS_TIMEOUT=30

# ===========================================
# 前端配置
# ===========================================
VUE_APP_API_BASE_URL=/api
VUE_APP_WS_URL=/
VUE_APP_TITLE=rPPG实时心率监测系统
VUE_APP_DEBUG=false

# ===========================================
# 数据库配置（如果需要）
# ===========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/rppg
# DATABASE_URL=mysql://user:password@localhost:3306/rppg
DATABASE_URL=sqlite:///rppg.db

# ===========================================
# Redis配置（如果需要缓存）
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# 监控配置
# ===========================================
MONITORING_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ===========================================
# 文件上传配置
# ===========================================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/tmp/uploads

# ===========================================
# 心率检测配置
# ===========================================
HEART_RATE_MIN=40
HEART_RATE_MAX=200
SAMPLE_RATE=30
WINDOW_SIZE=150

# ===========================================
# 图像处理配置
# ===========================================
IMAGE_WIDTH=640
IMAGE_HEIGHT=480
FACE_DETECTION_CONFIDENCE=0.5
FACE_TRACKING_ENABLED=true

# ===========================================
# 缓存配置
# ===========================================
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ===========================================
# CORS配置
# ===========================================
# 生产环境中应该指定具体的域名，而不是使用 *
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# ===========================================
# SSL配置
# ===========================================
SSL_CERT_PATH=/etc/nginx/ssl/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/server.key

# ===========================================
# 备份配置
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/opt/rppg/backups